<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>pro.api4</groupId>
    <artifactId>examples</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>JsonApi4j - Examples - Parent Module</name>

    <modules>
        <module>jsonapi4j-sampleapp-domain</module>
        <module>jsonapi4j-sampleapp-testsuite</module>
        <module>jsonapi4j-springboot-sampleapp</module>
        <module>jsonapi4j-quarkus-sampleapp</module>
        <module>jsonapi4j-servlet-sampleapp</module>
    </modules>

    <properties>
        <jsonapi4j.version>1.11.0-SNAPSHOT</jsonapi4j.version>

        <jakarta.servlet-api.version>6.1.0</jakarta.servlet-api.version>

        <quarkus.version>3.20.6</quarkus.version>
        <spring.boot.version>3.4.2</spring.boot.version>
        <springdoc-openapi.version>3.1.1</springdoc-openapi.version>

        <swagger.model.version>2.2.55</swagger.model.version>
        <lombok.version>1.18.48</lombok.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <jandex-maven-plugin.version>3.6.0</jandex-maven-plugin.version>

        <junit-jupiter.version>6.1.3</junit-jupiter.version>
        <assertj-core.version>3.27.7</assertj-core.version>
        <rest-assured.version>6.0.1</rest-assured.version>
        <json-unit.version>2.40.0</json-unit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--JsonApi4j-->
            <dependency>
                <groupId>pro.api4</groupId>
                <artifactId>jsonapi4j-core</artifactId>
                <version>${jsonapi4j.version}</version>
            </dependency>
            <dependency>
                <groupId>pro.api4</groupId>
                <artifactId>jsonapi4j-rest</artifactId>
                <version>${jsonapi4j.version}</version>
            </dependency>
            <dependency>
                <groupId>pro.api4</groupId>
                <artifactId>jsonapi4j-rest-springboot</artifactId>
                <version>${jsonapi4j.version}</version>
            </dependency>
            <dependency>
                <groupId>pro.api4</groupId>
                <artifactId>jsonapi4j-rest-quarkus</artifactId>
                <version>${jsonapi4j.version}</version>
            </dependency>
            <dependency>
                <groupId>pro.api4</groupId>
                <artifactId>jsonapi4j-all-plugins</artifactId>
                <version>${jsonapi4j.version}</version>
            </dependency>
            <dependency>
                <groupId>pro.api4</groupId>
                <artifactId>jsonapi4j-ac-plugin</artifactId>
                <version>${jsonapi4j.version}</version>
            </dependency>
            <dependency>
                <groupId>pro.api4</groupId>
                <artifactId>jsonapi4j-oas-plugin</artifactId>
                <version>${jsonapi4j.version}</version>
            </dependency>
            <dependency>
                <groupId>pro.api4</groupId>
                <artifactId>jsonapi4j-sampleapp-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>pro.api4</groupId>
                <artifactId>jsonapi4j-sampleapp-testsuite</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>jakarta.servlet</groupId>
                <artifactId>jakarta.servlet-api</artifactId>
                <version>${jakarta.servlet-api.version}</version>
            </dependency>

            <!-- OAS annotations -->
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>${swagger.model.version}</version>
            </dependency>

            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <!--Test Dependencies-->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit-jupiter.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj-core.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rest-assured</groupId>
                <artifactId>rest-assured</artifactId>
                <version>${rest-assured.version}</version>
            </dependency>
            <!--json-path, xml-path and rest-assured-common are managed by the Spring Boot BOM the sample apps
                import, so pinning rest-assured alone leaves a split family - the artifacts load each other's
                classes and fail with a ClassNotFoundException. All four move together.-->
            <dependency>
                <groupId>io.rest-assured</groupId>
                <artifactId>json-path</artifactId>
                <version>${rest-assured.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rest-assured</groupId>
                <artifactId>xml-path</artifactId>
                <version>${rest-assured.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rest-assured</groupId>
                <artifactId>rest-assured-common</artifactId>
                <version>${rest-assured.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.json-unit</groupId>
                <artifactId>json-unit</artifactId>
                <version>${json-unit.version}</version> <!-- Use latest -->
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.4</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>


    <profiles>
        <!--Builds the sample apps against Spring Boot 4; springdoc 3.x is the generation that targets it. Same
            id as the profile in jsonapi4j-rest-springboot, so one -Pspring-boot-4 covers the framework module and
            the samples together.

            The profile varies Spring Boot and nothing else on purpose: the test stack is identical on both axes,
            so a failure here is attributable to Spring rather than to a swapped test library.-->
        <profile>
            <id>spring-boot-4</id>
            <properties>
                <spring.boot.version>4.1.0</spring.boot.version>
                <springdoc-openapi.version>3.1.0</springdoc-openapi.version>
            </properties>
        </profile>
    </profiles>

</project>
